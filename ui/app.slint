export component AppWindow inherits Window {
    default-font-size: 30px;
    property <[float]> font-weights: [100, 200, 300, 400, 500, 600, 700, 800, 900, 1000];

    HorizontalLayout {
        spacing: 20px;

        VerticalLayout {
            spacing: 20px;
            Text {
                text: "SysSans";
                font-family: "OPPO Sans 4.0 SC";
            }

            for font-weight in font-weights: Text {
                text: "测试世界";
                font-family: "OPPO Sans 4.0 SC";
                font-weight: font-weight;
            }
        }

        VerticalLayout {
            spacing: 20px;
            Text {
                text: "SysFont";
                font-family: "OPPO Sans 4.0 SC";
            }

            for font-weight in font-weights: Text {
                text: "测试世界";
                font-family: "FZSJ-ZHUZAYTD";
                font-weight: font-weight;
            }
        }
    }
}
